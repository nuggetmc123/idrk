<!-- Keeps the WebSocket client from being stripped out of IL2CPP (Quest) builds. -->
<linker>
  <assembly fullname="System">
    <namespace fullname="System.Net.WebSockets" preserve="all"/>
  </assembly>
  <assembly fullname="System.Net.WebSockets" preserve="all" ignoreIfMissing="1"/>
  <assembly fullname="System.Net.WebSockets.Client" preserve="all" ignoreIfMissing="1"/>
</linker>
